managed implementation in class zbp_rt_r_travelcrg unique;
strict ( 2 );
with draft;

define behavior for ZRT_R_Travelcrg alias Travel
persistent table zrt_travelcrg
draft table zrt_d_travelcrg
lock master
authorization master ( global, instance )
etag master LocalLastChangedAt
total etag LastChangedAt
{
  create;
  update;
  delete;
  association _Booking { create; with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { validation validateDates; validation validateMandatory; }

  field ( numbering : managed, readonly ) TravelUUID;
  field ( readonly ) OverallStatus, TotalPrice, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) TravelID, AgencyID, CustomerID, BeginDate, EndDate, CurrencyCode;

  action ( features : instance ) acceptTravel result [1] $self;
  action deductDiscount parameter ZRT_A_Discountcrg result [1] $self;
  factory action copyTravel [1];
  internal action reCalcTotalPrice;

  determination setStatusOpen on modify { create; }
  determination calculateTotalPrice on modify { create; field BookingFee, CurrencyCode; }

  validation validateDates on save { create; field BeginDate, EndDate; }
  validation validateMandatory on save { create; field TravelID, AgencyID, CustomerID, CurrencyCode; }

  mapping for zrt_travelcrg corresponding
  {
    TravelUUID         = travel_uuid;
    TravelID           = travel_id;
    AgencyID           = agency_id;
    CustomerID         = customer_id;
    BeginDate          = begin_date;
    EndDate            = end_date;
    BookingFee         = booking_fee;
    TotalPrice         = total_price;
    CurrencyCode       = currency_code;
    Description        = description;
    OverallStatus      = overall_status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZRT_R_Bookingcrg alias Booking
persistent table zrt_bookingcrg
draft table zrt_d_bookingcrg
lock dependent by _Travel
authorization dependent by _Travel
etag master LocalLastChangedAt
{
  update;
  delete;
  association _Travel { with draft; }

  field ( numbering : managed, readonly ) BookingUUID;
  field ( readonly ) TravelUUID, LocalLastChangedAt;
  field ( mandatory ) BookingID, CarrierID, ConnectionID, FlightDate;

  determination calculateTotalPrice on modify { create; delete; field FlightPrice, CurrencyCode; }

  validation validateMandatory on save { create; field BookingID, CarrierID, ConnectionID, FlightDate; }

  mapping for zrt_bookingcrg corresponding
  {
    BookingUUID        = booking_uuid;
    TravelUUID         = parent_uuid;
    BookingID          = booking_id;
    BookingDate        = booking_date;
    CarrierID          = carrier_id;
    ConnectionID       = connection_id;
    FlightDate         = flight_date;
    FlightPrice        = flight_price;
    CurrencyCode       = currency_code;
    BookingStatus      = booking_status;
    LocalLastChangedAt = local_last_changed_at;
  }
}
